# ─── Live mode (default) ──────────────────────────────────────────────────────
# The api-gateway, including its global prefix. Every ML and LLM call goes here.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3400/api/v1

# Sentiment-backend's article corpus, used by the news list.
NEXT_PUBLIC_API_GATEWAY_URL=http://127.0.0.1:3400/api/v1/sentiment

# PayHere checkout endpoint (sandbox by default).
NEXT_PUBLIC_PAYHERE_ENV_URL=https://sandbox.payhere.lk/pay/checkout


# ─── Demo mode ────────────────────────────────────────────────────────────────
# Set to 1 to run the frontend with no backend at all, replaying real model
# output captured into public/demo-data/. See "Demo mode" in README.md.
#
# This is what the public demo deployment sets. Leave it unset for local
# development against a running stack.
# NEXT_PUBLIC_DEMO_MODE=1

# Speeds up replay of the captured financial-health stream, which is 18-31s of
# real pipeline. 1 = original pace, 2 = twice as fast. Ordering is preserved.
# Defaults to 8 (a run lands in ~4s); set 1 to watch the true pipeline timing.
# NEXT_PUBLIC_DEMO_STREAM_SPEED=8

# Ceiling on replayed fixture latency, in ms. Captured latency is honoured below
# this and clipped above it — the dividend LLM explanation really took ~12s.
# 0 replays uncapped.
# NEXT_PUBLIC_DEMO_MAX_LATENCY_MS=2500
